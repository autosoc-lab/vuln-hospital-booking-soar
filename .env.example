# Shuffle SOAR 설정 — 이 파일을 .env로 복사한 뒤 값을 채워서 사용
# 원본: https://github.com/Shuffle/Shuffle 의 기본 .env를 이 랩에 필요한 항목만 추려서 정리함.
# 전체 옵션 목록이 필요하면 위 저장소의 .env 파일을 참고할 것.
# 사용법: cp .env.example .env  (그 다음 아래 값들을 채운다)

# --- 필수: 반드시 값을 바꿔야 하는 항목 ---

# 인증정보 암호화에 쓰이는 시드. 한 번 정하면 절대 바꾸지 말 것(바꾸면 기존에 등록한
# 앱 인증정보를 전부 다시 입력해야 함). openssl rand -hex 32 등으로 생성.
SHUFFLE_ENCRYPTION_MODIFIER=change-me-random-32-byte-hex

# OpenSearch 관리자 비밀번호(초기 1회 설정용). 8자 이상, 대소문자/숫자/특수문자 포함 필요.
SHUFFLE_OPENSEARCH_PASSWORD=change-me-StrongPassw0rd!
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-StrongPassw0rd!

# 최초 관리자 계정 (min length 3). 비워두면 최초 접속 시 웹 UI에서 직접 가입 화면이 뜸.
SHUFFLE_DEFAULT_USERNAME=
SHUFFLE_DEFAULT_PASSWORD=

# --- 네트워크/접속 관련: EC2에 배포할 경우 퍼블릭 IP로 바꿔야 웹훅이 정상 동작 ---
# 로컬 docker compose로만 띄울 때는 기본값(shuffle-backend, localhost) 그대로 둬도 됨.
# EC2(vuln-hospital-booking-infra의 modules/shuffle)로 배포하면 user_data가 이 값을
# 인스턴스의 퍼블릭 IP로 자동 치환하므로 수동으로 바꿀 필요 없음.
BASE_URL=http://shuffle-backend:5001
SSO_REDIRECT_URL=http://localhost:3001
BACKEND_HOSTNAME=shuffle-backend
BACKEND_PORT=5001
FRONTEND_PORT=3001
FRONTEND_PORT_HTTPS=3443
OUTER_HOSTNAME=shuffle-backend

# --- 로컬 스토리지 경로 (상대경로면 이 파일 기준) ---
SHUFFLE_APP_HOTLOAD_LOCATION=./shuffle-apps
SHUFFLE_FILE_LOCATION=./shuffle-files
DB_LOCATION=./shuffle-database

# --- 그 외 기본값 유지 권장 항목 ---
ENVIRONMENT_NAME=Shuffle
DOCKER_API_VERSION=1.44
SHUFFLE_SKIPSSL_VERIFY=true
# opensearch 컨테이너의 self-signed 인증서 CN이 hostname(shuffle-opensearch)과
# 달라 backend가 TLS 검증에 실패하면서 'Waiting for database'에 멈추는 문제 방지.
SHUFFLE_OPENSEARCH_SKIPSSL_VERIFY=true
SHUFFLE_STATS_DISABLED=true
SHUFFLE_LOGS_DISABLED=true
SHUFFLE_ELASTIC=true
IS_KUBERNETES=false
SHUFFLE_PASS_WORKER_PROXY=TRUE
SHUFFLE_PASS_APP_PROXY=TRUE
HTTP_PROXY=
HTTPS_PROXY=
TZ=Asia/Seoul
